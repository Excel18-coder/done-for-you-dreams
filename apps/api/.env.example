# Database (PostgreSQL) — required
DATABASE_URL=postgresql://user:password@localhost:5432/aviation

# Session secret (openssl rand -hex 32) — required
SESSION_SECRET=change-me

# CORS: comma-separated frontend origins
FRONTEND_ORIGIN=http://localhost:8080

PORT=4000
NODE_ENV=development

# Email (Resend API or SMTP). If missing, the app works manually and never claims emails were sent.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# S3-compatible object storage (R2/S3). If missing, document metadata still works but file upload/download is disabled.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
